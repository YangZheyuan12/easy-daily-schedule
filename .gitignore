# ---------- 依赖与构建产物 ----------
node_modules
dist
dist-ssr

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
*.local
Thumbs.db

# ---------- Capacitor 原生壳（android/ ios/ 目录本身要入库）----------
# 只忽略构建产物与依赖，工程模板必须提交，否则别人 clone 后无法打包。
android/build/
android/app/build/
android/app/release/
android/.gradle/
android/local.properties
android/capacitor-cordova-android-plugins/build/
ios/App/build/
ios/App/Pods/
ios/App/public/
ios/App/Podfile.lock
ios/App/output/
# capacitor.config.json 与 web 资源都由 `cap sync` 生成，不入库
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/public/
ios/App/App/capacitor.config.json

# ---------- 缓存与一次性临时文件 ----------
.vite
coverage
*.log
*.tsbuildinfo
# vitest 的编译缓存（由 test:strict 生成，可随时重建）
.tmp-vitest/
# vite 启动时写出的时间戳临时文件
vite.config.ts.timestamp-*.mjs

# ---------- 代理工作目录 ----------
# .workbuddy/memory 要入库：它记录架构决策、项目约定与踩坑教训，是跨会话的项目知识。
# .workbuddy/tmp 是 scratch：截图、导出的 jsonl、html 板子等一次性产物，不入库。
#   长期有用的验证脚本已迁出到 scripts/tools/（入库，见其 README），不再是 tmp 的例外。
.workbuddy/tmp/*
